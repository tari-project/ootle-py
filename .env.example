# Template for the project-local environment file.
#
# Copy this file to `.env` (which is gitignored) and adjust the values for
# your machine. With direnv installed, the `.envrc` in this repo will load
# `.env` automatically when you `cd` into the project — run `direnv allow`
# once after cloning.

# Path to a local checkout of the Rust upstream `crates/wallet/ootle-rs/`.
# Used by agents and parity tests that need to read the Rust source.
OOTLE_RS_PATH="/path/to/tari-workspace/crates/wallet/ootle-rs"
